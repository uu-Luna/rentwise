# 环境
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# 数据库：本地可随时重建，但为了让 Streamlit Cloud 装上就能跑，
# 例外提交一份快照（含已补好的 2,940 个坐标，重建是补不回来的）
data/*.db
data/*.db-wal
data/*.db-shm
!data/rentwise.db

# 原始数据：政府公开数据，但全量镜像不随仓库分发
# 使用者跑 scripts/fetch_reference_prices.py 自己取
data/raw/*.csv

# 自己保存的贝壳页面：体积大（每页 2MB），且属第三方内容，不进仓库
data/manual/pages/

# 密钥
.env
.streamlit/secrets.toml

# 系统
.DS_Store
Thumbs.db
